# KGraph eval — environment template. Copy to .env (or export inline).
#
# All models route through a single Anthropic-compatible endpoint (a LiteLLM
# proxy in the dev setup). Point it at your provider and set one auth var.
#
#   ANTHROPIC_BASE_URL=http://...     # the proxy root (no /v1 suffix)
#   ANTHROPIC_AUTH_TOKEN=...           # preferred (sent as Bearer)
#   # ANTHROPIC_API_KEY=...           # alt: x-api-key style
#   ANTHROPIC_MODEL=GLM-5.2            # default model id; override per-run with --models
#
# NOTE: the LiteLLM proxy's per-key model allow-list is CASE-SENSITIVE. The dev
# key only allows GLM-5 / GLM-5.1 / Qwen3.7-Plus / GLM-5.2 (uppercase). A
# lowercase id returns 403 key_model_access_denied.

ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=GLM-5.2
